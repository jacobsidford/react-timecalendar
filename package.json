{
	"name": "react-timecalendar",
	"version": "3.0.0",
	"description": "Lightweight React calendar with time options for booking",
	"main": "build/index.js",
	"module": "build/index.es.js",
	"author": {
		"name": "Jacob Sidford",
		"email": "jacob.sidford@gmail.com"
	},
	"files": [
		"build",
		"LICENSE",
		"README.md"
	],
	"homepage": "https://jacobsidford.github.io/react-timecalendar/",
	"license": "MIT",
	"repository": "https://github.com/jacobsidford/react-timecalendar/",
	"keywords": [
		"react",
		"react-component",
		"calendar",
		"date-picker",
		"time-picker",
		"timeslot",
		"booking",
		"appointment",
		"scheduler",
		"typescript"
	],
	"dependencies": {
		"date-fns": "^4.1.0"
	},
	"scripts": {
		"build": "rm -rf build && rollup -c",
		"dev": "vite",
		"build:demo": "vite build",
		"preview": "vite preview",
		"test": "vitest run",
		"typecheck": "tsc --noEmit",
		"prepublishOnly": "npm run build"
	},
	"browserslist": [
		">0.2%",
		"not dead",
		"not ie <= 11",
		"not op_mini all"
	],
	"peerDependencies": {
		"react": ">=16.8.0",
		"react-dom": ">=16.8.0"
	},
	"devDependencies": {
		"@rollup/plugin-commonjs": "^25.0.7",
		"@rollup/plugin-node-resolve": "^15.2.3",
		"@rollup/plugin-typescript": "^11.1.6",
		"@testing-library/jest-dom": "^6.4.2",
		"@testing-library/react": "^14.2.1",
		"@types/node": "^20.19.43",
		"@types/react": "^18.2.66",
		"@types/react-dom": "^18.2.22",
		"@vitejs/plugin-react": "^4.2.1",
		"jsdom": "^24.0.0",
		"react": "^18.2.0",
		"react-dom": "^18.2.0",
		"rollup": "^2.79.1",
		"rollup-plugin-peer-deps-external": "^2.2.4",
		"rollup-plugin-postcss": "^4.0.2",
		"sass": "^1.71.1",
		"tslib": "^2.6.2",
		"typescript": "^5.4.2",
		"vite": "^5.1.6",
		"vitest": "^4.1.11"
	},
	"types": "build/index.d.ts",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./build/index.d.ts",
			"import": "./build/index.es.js",
			"require": "./build/index.js"
		},
		"./package.json": "./package.json"
	},
	"engines": {
		"node": ">=18"
	}
}
