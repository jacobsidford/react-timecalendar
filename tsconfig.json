{
	"compilerOptions": {
		"declaration": true,
		"noImplicitAny": true,
		"strict": true,
		"declarationDir": "build",
		"module": "esnext",
		"target": "es2017",
		"lib": ["dom", "es2017"],
		"sourceMap": true,
		"jsx": "react",
		"moduleResolution": "node",
		"allowSyntheticDefaultImports": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"types": ["node", "vitest/globals", "@testing-library/jest-dom"]
	},
	"include": ["src/**/*", "demo/**/*", "vite.config.ts"],
	"exclude": ["node_modules", "build", "dist-demo"]
}
